# 사이트 주소 (링크 미리보기·출처 확인에 사용). 비우면 Vercel 배포 주소를 씁니다.
NEXT_PUBLIC_SITE_URL=

# 신청서 메일: 네이버 메일 SMTP (D-01). 값은 Vercel 환경 변수에만 입력하고 저장소에 올리지 않습니다.
# 네이버 메일 → 환경설정 → POP3/IMAP 설정에서 SMTP 사용, 네이버 보안설정에서 2단계 인증 + 애플리케이션 비밀번호 발급
SMTP_USER=
SMTP_PASS=
# (선택) 기본값 smtp.naver.com / 465
SMTP_HOST=
SMTP_PORT=
# (선택) 받는 주소·보내는 주소. 비우면 SMTP_USER
INQUIRY_TO=
INQUIRY_FROM=

# (선택) 추가로 허용할 출처. 쉼표로 구분. 예) https://www.example.kr
ALLOWED_ORIGINS=

# (로컬 확인용) dryrun 이면 메일을 실제로 보내지 않습니다. 운영에서는 비워 둡니다.
MAIL_DRIVER=
