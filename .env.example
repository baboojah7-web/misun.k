# 사이트 주소 (링크 미리보기·출처 확인에 사용). 공개 주소는 https 로 입력
NEXT_PUBLIC_SITE_URL=https://example.kr

# 신청서 메일 (D-01 기본값: Resend). 값은 Vercel 환경 변수에만 입력하고 저장소에 올리지 않습니다.
RESEND_API_KEY=
# 받는 주소 (D-02)
INQUIRY_TO=
# 보내는 주소. Resend 에서 인증한 도메인의 주소여야 합니다. 예) 홈페이지 <no-reply@example.kr>
INQUIRY_FROM=

# (선택) 추가로 허용할 출처. 쉼표로 구분. 예) https://www.example.kr
ALLOWED_ORIGINS=

# (로컬 확인용) dryrun 이면 메일을 실제로 보내지 않습니다. 운영에서는 비워 둡니다.
MAIL_DRIVER=
